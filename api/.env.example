# Database Configuration
DATABASE_URL=sqlite:///./test.db
# For PostgreSQL: postgresql://user:password@localhost:5432/train_printed

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# File Upload Settings
MAX_UPLOAD_SIZE=100000000  # 100 MB in bytes
ALLOWED_EXTENSIONS=pdf

# Image Processing
PDF_DPI=300
LINE_KERNEL_WIDTH=60
LINE_KERNEL_HEIGHT=5
MIN_LINE_HEIGHT=25
MIN_LINE_WIDTH=100

# Security & Authentication
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Application Base URL
# Set this in production or when behind a proxy/load balancer
# If not set, the application will use the request base URL (auto-detected)
# Examples:
#   Development: http://localhost:8000
#   Production: https://api.example.com
#   Behind proxy: https://yourdomain.com/api
# APP_BASE_URL=http://localhost:8000
